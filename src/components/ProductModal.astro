---
import { boutiqueConfig } from '../data/boutique';
---

<!-- Modal Backdrop & Container -->
<div 
  id="product-modal" 
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-primary/70 backdrop-blur-sm transition-opacity"
  aria-labelledby="modal-title" 
  role="dialog" 
  aria-modal="true"
>
  <div class="flex min-h-screen items-center justify-center p-4 sm:p-6 text-center">
    
    <!-- Modal Card -->
    <div 
      id="modal-card"
      class="relative w-full max-w-3xl transform overflow-hidden rounded-2xl bg-background text-left align-middle shadow-modal transition-all border border-accent/40 my-8"
    >
      
      <!-- Close Button -->
      <button 
        type="button" 
        id="close-modal-btn"
        class="absolute top-4 right-4 z-10 p-2 text-primary/60 hover:text-primary hover:bg-background-subtle rounded-full transition-colors"
        aria-label="Tutup jendela modal"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-0">
        
        <!-- Modal Image Column -->
        <div class="md:col-span-5 bg-background-subtle relative min-h-[280px] md:min-h-full">
          <img 
            id="modal-image" 
            src="" 
            alt="" 
            class="w-full h-full object-cover object-center absolute inset-0" 
          />
          <div class="absolute top-4 left-4">
            <span id="modal-badge" class="hidden text-[11px] font-semibold tracking-wider uppercase px-2.5 py-1 rounded bg-accent text-primary"></span>
          </div>
        </div>

        <!-- Modal Content Column -->
        <div class="md:col-span-7 p-6 sm:p-8 space-y-6">
          
          <div>
            <span id="modal-category" class="text-xs uppercase tracking-widest font-semibold text-accent"></span>
            <h3 id="modal-title" class="font-serif text-2xl sm:text-3xl font-normal text-primary mt-1"></h3>
            
            <div class="flex items-baseline gap-3 mt-2">
              <span id="modal-price" class="text-2xl font-bold text-primary"></span>
              <span id="modal-original-price" class="hidden text-sm line-through text-primary/40"></span>
            </div>
          </div>

          <!-- Deskripsi & Karakter Bahan -->
          <div class="space-y-2 text-sm">
            <h4 class="font-semibold text-primary uppercase tracking-wider text-xs flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Detail & Karakter Bahan
            </h4>
            <p id="modal-fabric" class="p-3 rounded-lg bg-background-subtle text-primary/80 border border-primary/5 text-xs leading-relaxed"></p>
            <p id="modal-description" class="text-primary/70 text-xs leading-relaxed"></p>
          </div>

          <!-- Color Selector -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-semibold text-primary uppercase tracking-wider">
              <span>Pilihan Warna</span>
              <span id="selected-color-label" class="text-accent normal-case font-medium"></span>
            </div>
            <div id="modal-colors-container" class="flex flex-wrap gap-2"></div>
          </div>

          <!-- Size Selector -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-semibold text-primary uppercase tracking-wider">
              <span>Pilihan Ukuran</span>
              <span id="selected-size-label" class="text-accent normal-case font-medium"></span>
            </div>
            <div id="modal-sizes-container" class="flex flex-wrap gap-2"></div>
          </div>

          <!-- Panduan Size Chart Table -->
          <div class="space-y-2">
            <div class="text-xs font-semibold text-primary uppercase tracking-wider flex items-center justify-between">
              <span>Panduan Ukuran (Size Chart Standard)</span>
              <span class="text-[10px] text-primary/50 font-normal">Toleransi ± 1-2 cm</span>
            </div>
            <div class="overflow-x-auto border border-primary/10 rounded-lg">
              <table class="w-full text-left text-[11px] text-primary/80">
                <thead class="bg-background-subtle text-primary border-b border-primary/10 font-semibold">
                  <tr>
                    <th class="py-1.5 px-2.5">Size</th>
                    <th class="py-1.5 px-2.5">Lingkar Dada</th>
                    <th class="py-1.5 px-2.5">Pinggang</th>
                    <th class="py-1.5 px-2.5">Panjang</th>
                  </tr>
                </thead>
                <tbody id="modal-measurements-body" class="divide-y divide-primary/5">
                </tbody>
              </table>
            </div>
          </div>

          <!-- Action CTA WhatsApp -->
          <div class="pt-2">
            <a 
              id="modal-wa-btn"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-3 py-3.5 px-6 rounded-full bg-primary text-background hover:bg-primary-hover border border-accent/40 font-semibold text-sm tracking-wide transition-all shadow-md group"
            >
              <svg class="w-5 h-5 text-whatsapp" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              </svg>
              <span id="modal-wa-btn-text">Pesan Sekarang via WhatsApp</span>
            </a>
            <p class="text-[11px] text-center text-primary/50 mt-2">
              Langsung terhubung dengan Customer Service Butik • Fast Response
            </p>
          </div>

        </div>

      </div>

    </div>
  </div>
</div>

<script define:vars={{ boutiquePhone: boutiqueConfig.whatsappNumber }}>
  let currentProduct = null;
  let selectedColor = '';
  let selectedSize = '';

  const modal = document.getElementById('product-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const titleEl = document.getElementById('modal-title');
  const categoryEl = document.getElementById('modal-category');
  const priceEl = document.getElementById('modal-price');
  const originalPriceEl = document.getElementById('modal-original-price');
  const fabricEl = document.getElementById('modal-fabric');
  const descriptionEl = document.getElementById('modal-description');
  const imageEl = document.getElementById('modal-image');
  const badgeEl = document.getElementById('modal-badge');
  const colorsContainer = document.getElementById('modal-colors-container');
  const sizesContainer = document.getElementById('modal-sizes-container');
  const measurementsBody = document.getElementById('modal-measurements-body');
  const waBtn = document.getElementById('modal-wa-btn');
  const selectedColorLabel = document.getElementById('selected-color-label');
  const selectedSizeLabel = document.getElementById('selected-size-label');

  function updateWhatsAppLink() {
    if (!currentProduct || !waBtn) return;
    const colorText = selectedColor ? ` - Warna ${selectedColor}` : '';
    const sizeText = selectedSize ? ` - Ukuran ${selectedSize}` : '';
    const message = `Halo Admin butikqu, saya tertarik memesan koleksi *${currentProduct.name}*${colorText}${sizeText} yang ada di website. Apakah stoknya masih tersedia?`;
    waBtn.href = `https://wa.me/${boutiquePhone}?text=${encodeURIComponent(message)}`;
  }

  function openProductModal(product) {
    if (!modal) return;
    currentProduct = product;
    selectedColor = product.colors && product.colors.length > 0 ? product.colors[0] : '';
    selectedSize = product.sizes && product.sizes.length > 0 ? product.sizes[0] : '';

    if (titleEl) titleEl.textContent = product.name;
    if (categoryEl) categoryEl.textContent = product.categoryLabel;
    if (priceEl) {
      priceEl.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.price);
    }
    
    if (originalPriceEl) {
      if (product.originalPrice) {
        originalPriceEl.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.originalPrice);
        originalPriceEl.classList.remove('hidden');
      } else {
        originalPriceEl.classList.add('hidden');
      }
    }

    if (fabricEl) fabricEl.textContent = product.fabric;
    if (descriptionEl) descriptionEl.textContent = product.description;
    if (imageEl) {
      imageEl.src = product.image;
      imageEl.alt = product.name;
    }

    if (badgeEl) {
      if (product.badge) {
        badgeEl.textContent = product.badge;
        badgeEl.classList.remove('hidden');
      } else {
        badgeEl.classList.add('hidden');
      }
    }

    // Render Colors
    if (colorsContainer && selectedColorLabel) {
      colorsContainer.innerHTML = '';
      selectedColorLabel.textContent = selectedColor;
      if (product.colors && product.colors.length > 0) {
        product.colors.forEach((col) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `px-3 py-1.5 rounded-md text-xs font-medium border transition-all ${
            col === selectedColor 
              ? 'bg-primary text-background border-primary shadow-sm' 
              : 'bg-background text-primary border-primary/20 hover:border-accent'
          }`;
          btn.textContent = col;
          btn.onclick = () => {
            selectedColor = col;
            if (selectedColorLabel) selectedColorLabel.textContent = col;
            colorsContainer.querySelectorAll('button').forEach((b) => {
              b.className = `px-3 py-1.5 rounded-md text-xs font-medium border transition-all ${
                b.textContent === col 
                  ? 'bg-primary text-background border-primary shadow-sm' 
                  : 'bg-background text-primary border-primary/20 hover:border-accent'
              }`;
            });
            updateWhatsAppLink();
          };
          colorsContainer.appendChild(btn);
        });
      }
    }

    // Render Sizes
    if (sizesContainer && selectedSizeLabel) {
      sizesContainer.innerHTML = '';
      selectedSizeLabel.textContent = selectedSize;
      if (product.sizes && product.sizes.length > 0) {
        product.sizes.forEach((sz) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `px-3 py-1.5 rounded-md text-xs font-medium border transition-all ${
            sz === selectedSize 
              ? 'bg-accent text-primary border-accent font-semibold shadow-sm' 
              : 'bg-background text-primary border-primary/20 hover:border-accent'
          }`;
          btn.textContent = sz;
          btn.onclick = () => {
            selectedSize = sz;
            if (selectedSizeLabel) selectedSizeLabel.textContent = sz;
            sizesContainer.querySelectorAll('button').forEach((b) => {
              b.className = `px-3 py-1.5 rounded-md text-xs font-medium border transition-all ${
                b.textContent === sz 
                  ? 'bg-accent text-primary border-accent font-semibold shadow-sm' 
                  : 'bg-background text-primary border-primary/20 hover:border-accent'
              }`;
            });
            updateWhatsAppLink();
          };
          sizesContainer.appendChild(btn);
        });
      }
    }

    // Render Measurements
    if (measurementsBody) {
      measurementsBody.innerHTML = '';
      const measurements = product.measurements || [
        { size: 'S', bust: '88-92 cm', waist: '68-72 cm', length: '135 cm' },
        { size: 'M', bust: '94-98 cm', waist: '74-78 cm', length: '137 cm' },
        { size: 'L', bust: '100-104 cm', waist: '80-84 cm', length: '138 cm' },
        { size: 'XL', bust: '106-110 cm', waist: '86-90 cm', length: '140 cm' },
      ];
      measurements.forEach((m) => {
        const row = document.createElement('tr');
        row.className = 'hover:bg-background-subtle';
        row.innerHTML = `
          <td class="py-1.5 px-2.5 font-semibold text-primary">${m.size}</td>
          <td class="py-1.5 px-2.5">${m.bust}</td>
          <td class="py-1.5 px-2.5">${m.waist}</td>
          <td class="py-1.5 px-2.5">${m.length}</td>
        `;
        measurementsBody.appendChild(row);
      });
    }

    updateWhatsAppLink();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  // Listen to custom DOM event from Catalog or any other component
  window.addEventListener('open-product-modal', (event) => {
    const customEvent = event;
    if (customEvent && customEvent.detail) {
      openProductModal(customEvent.detail);
    }
  });

  // Expose directly to window as well
  window.openProductModal = openProductModal;

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
