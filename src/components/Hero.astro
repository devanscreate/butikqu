---
import { boutiqueConfig, buildWhatsAppLink } from '../data/boutique';
const waLink = buildWhatsAppLink();
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-16 md:pb-24 border-b border-primary/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copywriting & CTA -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-accent/40 bg-accent/10 text-primary text-xs font-semibold tracking-widest uppercase">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span>Koleksi Eksklusif &bull; Musim 2026</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-[1.15] text-primary">
          Keanggunan Abadi dalam Setiap <span class="italic font-medium text-accent">Jahitan Presisi</span>
        </h1>

        <p class="text-base sm:text-lg text-primary/70 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">
          {boutiqueConfig.subtagline} Setiap potong busana diproduksi terbatas untuk menjaga orisinalitas dan keanggunan pemakainya.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="#katalog"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full bg-primary text-background hover:bg-primary-hover border border-accent/40 text-sm font-semibold tracking-wider uppercase transition-all shadow-md hover:shadow-lg group"
          >
            <span>Lihat Koleksi Terbaru</span>
            <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-surface border border-primary/20 hover:border-accent text-primary hover:text-accent text-sm font-semibold tracking-wider uppercase transition-all shadow-sm"
          >
            <svg class="w-4 h-4 text-whatsapp" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span>Konsultasi Ukuran</span>
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-primary/10 max-w-lg mx-auto lg:mx-0">
          <div>
            <div class="font-serif text-2xl font-semibold text-primary">100%</div>
            <div class="text-xs text-primary/70 mt-0.5">Bahan Terkurasi</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-semibold text-primary">4.9 / 5.0</div>
            <div class="text-xs text-primary/70 mt-0.5">Kepuasan Pelanggan</div>
          </div>
          <div>
            <div class="font-serif text-2xl font-semibold text-primary">Toko Fisik</div>
            <div class="text-xs text-primary/70 mt-0.5">Senopati, Jaksel</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Decorative Frame -->
          <div class="absolute -inset-2 rounded-2xl border border-accent/40 translate-x-2 translate-y-2 -z-10 pointer-events-none"></div>

          <!-- Main Image Card -->
          <div class="relative rounded-2xl overflow-hidden bg-primary/5 shadow-2xl aspect-[3/4] border border-primary/10">
            <img 
              src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=85" 
              alt="Koleksi busana eksklusif butikqu" 
              class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            
            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-transparent to-transparent"></div>
            
            <!-- Floating Lookbook Badge -->
            <div class="absolute bottom-5 left-5 right-5 p-4 rounded-xl bg-background/90 backdrop-blur-md border border-accent/40 shadow-soft">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-[10px] uppercase tracking-wider font-semibold text-accent">Signature Series</span>
                  <h4 class="font-serif text-base font-semibold text-primary">The Modern Silhouette</h4>
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded bg-primary text-background">
                  Ready Stock
                </span>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

