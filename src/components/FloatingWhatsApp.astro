---
import { boutiqueConfig, buildWhatsAppLink } from '../data/boutique';
const waLink = buildWhatsAppLink();
---

<!-- Floating WhatsApp Quick Action Button -->
<aside class="fixed bottom-6 right-6 z-40 flex items-center gap-3">
  
  <!-- Tooltip Bubble (Disappears on Mobile when clicked) -->
  <div class="hidden sm:flex items-center gap-2 bg-background/95 backdrop-blur-md text-primary text-xs font-semibold px-4 py-2 rounded-full border border-accent/40 shadow-card animate-bounce">
    <span class="w-2 h-2 rounded-full bg-whatsapp animate-ping"></span>
    <span>Butuh bantuan ukuran? Chat Kami</span>
  </div>

  <!-- Main Floating Button -->
  <a
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    class="relative group flex items-center justify-center w-14 h-14 rounded-full bg-whatsapp text-white shadow-modal hover:scale-110 active:scale-95 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-whatsapp/30"
    aria-label="Konsultasi langsung via WhatsApp admin butikqu"
  >
    <!-- Ping effect ring -->
    <span class="absolute inline-flex h-full w-full rounded-full bg-whatsapp opacity-30 animate-ping pointer-events-none"></span>

    <!-- WhatsApp SVG -->
    <svg class="w-8 h-8 fill-current relative z-10" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.303-.058.116-.087.188-.173.289l-.26.302c-.087.087-.179.182-.077.357.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
    </svg>
  </a>

</aside>

