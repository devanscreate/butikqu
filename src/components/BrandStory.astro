---
import { boutiqueConfig } from '../data/boutique';
import { testimonialsData } from '../data/products';
---

<!-- Brand Philosophy & Advantages Section -->
<section id="keunggulan" class="py-16 md:py-24 bg-background-subtle border-y border-primary/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/40 bg-accent/10 text-primary text-xs font-semibold tracking-widest uppercase">
        <span>Filosofi & Kualitas</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-primary">
        Standar Kualitas Tanpa Kompromi
      </h2>
      <p class="text-sm sm:text-base text-primary/70 leading-relaxed font-light">
        Kami percaya bahwa pakaian bukan sekadar penutup tubuh, melainkan refleksi karakter dan rasa percaya diri pemakainya.
      </p>
    </div>

    <!-- 4 Pillars of Excellence -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {boutiqueConfig.features.map((feature, idx) => (
        <div class="bg-background-card p-6 sm:p-8 rounded-2xl border border-primary/10 hover:border-accent/60 transition-all duration-300 shadow-soft group">
          <div class="w-12 h-12 rounded-xl bg-primary text-accent flex items-center justify-center font-serif text-xl font-bold mb-6 group-hover:bg-accent group-hover:text-primary transition-colors">
            0{idx + 1}
          </div>
          <h3 class="font-serif text-xl font-semibold text-primary mb-3">
            {feature.title}
          </h3>
          <p class="text-xs sm:text-sm text-primary/70 leading-relaxed font-light">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Brand Story & Atelier Showcase -->
<section id="cerita" class="py-16 md:py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Visual Imagery Column -->
      <div class="lg:col-span-5 relative order-2 lg:order-1">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="rounded-2xl overflow-hidden shadow-card border border-primary/10 aspect-[4/5] bg-primary/5">
            <img 
              src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1000&q=80" 
              alt="Atelier butikqu dan proses pemilihan bahan kain premium" 
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-6 -right-6 hidden sm:block p-5 rounded-2xl bg-background-card border border-accent/40 shadow-modal max-w-xs">
            <p class="font-serif text-sm italic text-primary/80">
              "Koleksi terbatas untuk wanita yang mengutamakan kualitas jahitan dan kenyamanan hakiki."
            </p>
            <span class="block text-[11px] font-semibold text-accent uppercase tracking-wider mt-2">
              — Founder of butikqu
            </span>
          </div>
        </div>
      </div>

      <!-- Story Text Column -->
      <div class="lg:col-span-7 space-y-6 order-1 lg:order-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/40 bg-accent/10 text-primary text-xs font-semibold tracking-widest uppercase">
          <span>Tentang butikqu</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-primary leading-tight">
          Sentuhan Personal & <span class="italic text-accent">Keahlian Menjahit</span> Tradisi Butik
        </h2>

        <p class="text-sm sm:text-base text-primary/70 leading-relaxed font-light">
          Berawal dari butik fisik di kawasan Senopati, <strong>butikqu</strong> lahir dari keresahan akan busana siap pakai massal yang kerap mengorbankan kualitas bahan dan kerapian jahitan. Kami memilih setiap rol kain secara langsung, memastikan sirkulasi udara yang nyaman, serta memotong pola dengan teliti agar jatuhnya busana menonjolkan keanggunan siluet alami tubuh.
        </p>

        <p class="text-sm sm:text-base text-primary/70 leading-relaxed font-light">
          Setiap rilisan dibuat dalam kuantitas terbatas (*limited runs*), menjamin eksklusivitas busana Anda di berbagai agenda istimewa, mulai dari perayaan keluarga, pesta pernikahan, hingga penampilan santai berkelas.
        </p>

        <!-- Social Channels & Community -->
        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a 
            href={boutiqueConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-background-subtle border border-primary/15 hover:border-accent text-primary hover:text-accent text-xs font-semibold tracking-wider uppercase transition-all"
          >
            <!-- Instagram Icon -->
            <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>Instagram @butikqu.official</span>
          </a>

          <a 
            href={boutiqueConfig.socials.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-background-subtle border border-primary/15 hover:border-accent text-primary hover:text-accent text-xs font-semibold tracking-wider uppercase transition-all"
          >
            <!-- TikTok Icon -->
            <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
            <span>TikTok @butikqu.official</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Customer Reviews & Social Proof Section -->
<section class="py-16 md:py-24 bg-background-subtle border-t border-primary/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/40 bg-accent/10 text-primary text-xs font-semibold tracking-widest uppercase">
        <span>Ulasan Terverifikasi</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-primary">
        Apa Kata Sahabat <span class="text-accent italic font-medium">butikqu</span>
      </h2>
      <p class="text-sm sm:text-base text-primary/70 leading-relaxed font-light">
        Kepercayaan dan kepuasan pelanggan adalah motivasi terbesar kami untuk terus menghadirkan karya terbaik.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonialsData.map((item) => (
        <div class="bg-background-card p-6 sm:p-8 rounded-2xl border border-primary/10 hover:border-accent/60 transition-all duration-300 shadow-soft flex flex-col justify-between">
          <div class="space-y-4">
            <!-- 5 Star Rating -->
            <div class="flex items-center gap-1 text-accent">
              {Array.from({ length: item.rating }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <p class="text-sm text-primary/80 leading-relaxed italic">
              "{item.comment}"
            </p>
          </div>

          <div class="pt-6 border-t border-primary/10 mt-6">
            <h4 class="font-serif text-base font-semibold text-primary">{item.name}</h4>
            <p class="text-xs text-primary/60">{item.role}</p>
            <div class="mt-2 text-[11px] text-accent font-medium inline-block bg-accent/10 px-2 py-0.5 rounded">
              Item: {item.purchasedItem}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
