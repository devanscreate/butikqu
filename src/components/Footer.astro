---
import { boutiqueConfig, buildWhatsAppLink } from '../data/boutique';
const waLink = buildWhatsAppLink();
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-background border-t border-primary-hover pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-background/10">
      
      <!-- Brand & Philosophy Column -->
      <div class="lg:col-span-5 space-y-4">
        <a href="#" class="inline-flex items-baseline gap-1">
          <span class="font-serif text-3xl font-semibold text-background">
            {boutiqueConfig.name}
          </span>
          <span class="w-2 h-2 rounded-full bg-accent inline-block"></span>
        </a>
        <p class="text-xs sm:text-sm text-background/70 max-w-sm leading-relaxed font-light">
          {boutiqueConfig.subtagline}
        </p>
        <div class="pt-2 text-xs text-accent">
          Atelier & Offline Store: {boutiqueConfig.address.street}, {boutiqueConfig.address.city}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-accent">
          Eksplorasi
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-background/70 font-light">
          <li><a href="#katalog" class="hover:text-accent transition-colors">Semua Koleksi</a></li>
          <li><a href="#keunggulan" class="hover:text-accent transition-colors">Kualitas Material & Jahitan</a></li>
          <li><a href="#cerita" class="hover:text-accent transition-colors">Cerita & Filosofi Butik</a></li>
          <li><a href="#lokasi" class="hover:text-accent transition-colors">Lokasi & Petunjuk Arah</a></li>
          <li><a href="/keystatic" class="text-accent/60 hover:text-accent transition-colors">Portal CMS Admin</a></li>
        </ul>
      </div>

      <!-- Customer Service & Hours -->
      <div class="lg:col-span-4 space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-accent">
          Layanan Pelanggan
        </h4>
        <div class="space-y-2 text-xs sm:text-sm text-background/70 font-light">
          <p>
            <strong class="text-background font-normal">Jam Operasional:</strong><br />
            {boutiqueConfig.hours.days}<br />
            {boutiqueConfig.hours.time}
          </p>
          <p>
            <strong class="text-background font-normal">Kontak WhatsApp Admin:</strong><br />
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
              {boutiqueConfig.phoneDisplay}
            </a>
          </p>
          <div class="pt-2 flex items-center gap-4 text-xs">
            <a href={boutiqueConfig.socials.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
              Instagram
            </a>
            <span class="text-background/30">&bull;</span>
            <a href={boutiqueConfig.socials.tiktok} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">
              TikTok
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Attribution & Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-background/50 gap-4">
      <p>
        &copy; {currentYear} {boutiqueConfig.name}. Hak Cipta Dilindungi Undang-Undang.
      </p>
      <p class="flex items-center gap-2">
        <span>Dibangun dengan Astro + Tailwind CSS</span>
        <span>&bull;</span>
        <span>Cloudflare Pages</span>
      </p>
    </div>

  </div>
</footer>

