---
import '../styles/global.css';
import { boutiqueConfig } from '../data/boutique';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${boutiqueConfig.name} — Koleksi Busana Elegan & Eksklusif`,
  description = `${boutiqueConfig.name}: Landing page katalog busana butik eksklusif dengan presisi jahitan standard atelier dan material sutra, katun, serta linen premium. Kunjungi butik kami di Senopati, Jakarta Selatan.`,
  image = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1200&q=80',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://butikqu.pages.dev');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90' fill='%23C5A880'>✦</text></svg>" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1A1A1A" />

    <!-- Open Graph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={boutiqueConfig.name} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-primary antialiased selection:bg-accent selection:text-primary">
    <slot />
  </body>
</html>

