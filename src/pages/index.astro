---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import BrandStory from '../components/BrandStory.astro';
import StoreLocator from '../components/StoreLocator.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout>
  <Header />
  <main class="flex-1">
    <Hero />
    <Catalog />
    <BrandStory />
    <StoreLocator />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>

